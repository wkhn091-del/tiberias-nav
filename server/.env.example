# Copy to .env for local dev, or paste these as variables in your cloud
# platform's dashboard. Everything here has a working default except MONGO_URI
# in production — the server runs fine with no .env at all on a dev machine.

# ---- core ----
# PORT is INJECTED by Railway/Render/Fly. Do NOT set it there: bind to whatever
# the platform provides, or health checks will fail. Local default is 8080.
PORT=8080
# All interfaces. Required in a container; 127.0.0.1 would be unreachable.
HOST=0.0.0.0
# Shown in the startup log so the boot banner prints real, clickable URLs.
# e.g. https://tiberias-nav-production.up.railway.app
PUBLIC_URL=

# ---- database ----
# Local:      mongodb://localhost:27017/highway90
# Atlas:      mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/highway90?retryWrites=true&w=majority
# The server degrades to in-memory mode if this is unreachable — routing,
# search and reports still work, but profiles and history don't persist.
MONGO_URI=mongodb://localhost:27017/highway90
MONGO_TIMEOUT_MS=8000

# ---- upstream services (public demo endpoints; see the deploy notes) ----
OSRM_URL=https://router.project-osrm.org
NOMINATIM_URL=https://nominatim.openstreetmap.org
OVERPASS_URL=https://overpass-api.de/api/interpreter

# ---- tuning ----
# Keepalive ping. Cloud proxies drop idle WebSockets at ~55s, so stay under it.
WS_HEARTBEAT_MS=30000
# Grace period before a forced exit on SIGTERM.
SHUTDOWN_TIMEOUT_MS=8000
# Gamification
POINTS_PER_REPORT=10
POINTS_PER_KM=1
DISTANCE_FLUSH_KM=0.25
# Reports
REPORT_COOLDOWN_MS=5000
REPORT_TTL_MS=3600000

# ---- automatic congestion detection (Phase 23) ----
# Below this speed, while still moving, counts as congested.
CONGESTION_SPEED_KMH=15
# Lower bound of the congestion band (km/h). Under this = stopped/noise.
CONGESTION_MIN_SPEED_KMH=3
# Fixes looser than this (metres) are ignored for JAM DETECTION only — the fix
# is still mapped and sent as telemetry. Filters indoor/Wi-Fi drift.
CONGESTION_MAX_ACCURACY_M=30
# Density rule: a jam needs corroboration from independent devices.
CLUSTER_RADIUS_M=200
CLUSTER_MIN_DRIVERS=2
CLUSTER_FRESH_MS=15000
# Consecutive slow pings required before a jam is auto-reported.
CONGESTION_MIN_PINGS=3
# Optional wall-clock floor on that streak, in ms. 0 = off.
# At a ~2s ping interval, 3 pings is only ~6s — which a car creeping up to a red
# light can satisfy. Set this to 30000 in the field to require a sustained
# slowdown and cut those false positives.
CONGESTION_MIN_SPAN_MS=0
# Don't auto-report a second jam within this radius/window.
CONGESTION_DEDUP_RADIUS_M=500
CONGESTION_DEDUP_MS=900000

# ---- social live map (Phase 24) ----
# Radius within which other drivers are shared with you.
LIVE_RADIUS_M=5000
# How often nearby_drivers is fanned out to every connected driver.
LIVE_BROADCAST_MS=3000
# A driver with no ping for this long is dropped from the registry.
DRIVER_TTL_MS=20000
# Hard cap per frame (nearest-first) so a dense area can't bloat the payload.
MAX_NEARBY_DRIVERS=50
# How often a driver's gamification rank is re-read from Mongo.
RANK_REFRESH_MS=300000

# ---- saved places (Phase 25) ----
# Max favourites per user; oldest are dropped once the cap is hit.
MAX_SAVED_PLACES=50

# ---- social interactions (Phase 26) ----
# Per-sender cooldown between honks/likes.
INTERACTION_COOLDOWN_MS=10000
# Per-PAIR cooldown — the real anti-farming control for likes.
INTERACTION_PAIR_COOLDOWN_MS=300000
# Points awarded to the RECIPIENT of a like (senders get nothing).
POINTS_PER_LIKE=1

# ---- traffic signals along the route (Phase 28) ----
# Corridor half-width around the route when querying Overpass for signals.
SIGNALS_BUFFER_M=40
# Route is downsampled to ~one probe per this many metres before querying.
SIGNALS_SAMPLE_M=250
SIGNALS_MAX_PROBES=120
SIGNALS_MAX_RESULTS=250

# ---- Overpass resilience (Phase 29) ----
# After a 429/503/504 from Overpass, stop calling it for this long. During the
# cooldown, traffic-signal lookups are skipped entirely and category search
# falls back to Nominatim — so search keeps working when the quota is spent.
OVERPASS_COOLDOWN_MS=180000

# ---- lane counts along the route (Phase 32) ----
# How close a route point must be to an OSM way to adopt its lane count.
LANES_MATCH_M=25

# mobile_app/.env.example — copy to .env and edit if you need it.
#
# You normally do NOT need this file. lib/config.ts resolves the backend on its
# own: Metro's host during local dev, PROD_URL for a standalone build.
#
# Set this only to force a specific backend, e.g. pointing a dev build at
# staging. EXPO_PUBLIC_ is the prefix Expo inlines at build time — anything
# without it is stripped from the bundle and reads as undefined on device.
#
# Accepted forms:
#   staging.example.com        -> https + wss, no port (a deployed host)
#   10.0.0.9:3000              -> http + ws  (a LAN box on its port)
#   https://api.example.com    -> used verbatim
#
# EXPO_PUBLIC_SERVER_HOST=
